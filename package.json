{
  "name": "47kokushi-wasm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "asc engine/main.ts --outFile public/engine.wasm --optimize --runtime incremental --exportRuntime",
    "build:web": "vite build",
    "build": "npm run build:wasm && npm run build:web",
    "dev:wasm": "asc engine/main.ts --outFile public/engine.wasm --sourceMap --runtime incremental --exportRuntime",
    "dev": "npm run dev:wasm && vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "assemblyscript": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
